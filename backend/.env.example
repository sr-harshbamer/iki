# Copy to .env and fill in your own key. Never commit .env.
# Powers the semantic analysis pass (Analyze), screenshot vision (Image
# Check), and the Behavioral Impersonation Engine's Tier 2 cross-reference
# (Voice Guard) -- one key covers all three, Claude is natively multimodal.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-opus-5
ANTHROPIC_VISION_MODEL=claude-opus-5

# Optional. A Slack or Discord "incoming webhook" URL -- when a Likely Scam
# or High Risk verdict comes back, SuSagi posts an alert here. Leave blank
# to skip webhook notifications (escalations are still logged for the
# Insights dashboard either way).
TRUSTED_CONTACT_WEBHOOK_URL=

# Optional. Lets Voice Guard's critical-risk intervention message a real
# "Guardian" contact instead of just logging the escalation. Create a bot
# via @BotFather, then message it once and hit
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
