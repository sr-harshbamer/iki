# Copy to .env and fill in your own key. Never commit .env.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional. A Slack or Discord "incoming webhook" URL -- when a Likely Scam
# or High Risk verdict comes back, Veridra posts an alert here. Leave blank
# to skip webhook notifications (escalations are still logged for the
# Insights dashboard either way).
TRUSTED_CONTACT_WEBHOOK_URL=
